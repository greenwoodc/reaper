username = your_soulseek_username
password = your_soulseek_password
path = /data/incoming
format = mp3,flac,ogg
pref-format = flac
pref-min-bitrate = 256
name-format = {artist}/{album}/{artist} - {title}
skip-existing = true
search-timeout = 15000
listen-port = 54880
max-stale-time = 15000
fast-search = false
fast-search-min-up-speed = 100
min-shares-aggregate = 1
max-samplerate = 44100
desperate = true
concurrent-searches = 3
searches-per-time = 4
searches-renew-time = 120
concurrent-jobs = 3
