# systemd units can't read .env/env-var substitution, so User/WorkingDirectory/
# ExecStart below are hardcoded to this deployment — adjust for yours.
[Unit]
Description=Reaper backend (Flask API)
After=network.target

[Service]
Type=simple
User=chris
WorkingDirectory=/opt/reaper
ExecStart=/opt/reaper/venv/bin/python3 backend/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
