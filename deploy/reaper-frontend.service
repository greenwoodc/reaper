# systemd units can't read .env/env-var substitution, so User/WorkingDirectory/
# the port below are hardcoded to this deployment — adjust all three for yours
# (the port here, 3002, was picked to dodge two other Docker containers
# already bound to 3000/3001 on this particular box; yours may differ).
[Unit]
Description=Reaper frontend (Next.js)
After=network.target

[Service]
Type=simple
User=chris
WorkingDirectory=/opt/reaper/frontend
Environment=NODE_ENV=production
ExecStart=/bin/bash -lc 'source $HOME/.nvm/nvm.sh && nvm use default >/dev/null && exec npm run start -- -p 3002'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
